quadratic <- function(a, b, c) {
discriminant <- b^2 - 4*a*c
if (a == 0) {
print("This is not a quadratic equation")
} else if (discriminant > 0) {
x1 <- (-b + sqrt(discriminant)) / (2*a)
x2 <- (-b - sqrt(discriminant)) / (2*a)
print(paste("First root:", x1))
print(paste("Second root:", x2))
} else if (discriminant == 0) {
x <- -b / (2*a)
print(paste("One repeated root:", x))
} else {
print("No real roots")
}
}
quadratic(2,3,4)
quadratic(1, -5, 6)
quadratic(1, 0, -4)
